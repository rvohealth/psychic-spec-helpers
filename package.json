{
  "type": "module",
  "name": "@rvoh/psychic-spec-helpers",
  "version": "3.3.0",
  "description": "psychic framework spec helpers",
  "author": "RVO Health",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvohealth/psychic-spec-helpers.git"
  },
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    }
  },
  "files": [
    "tsconfig.json",
    "src/**/*",
    "dist/**/*"
  ],
  "scripts": {
    "client": "cd client && VITE_PSYCHIC_ENV=development pnpm dev",
    "client:fspec": "cd client && BROWSER=none VITE_PSYCHIC_ENV=test pnpm dev --port 3000",
    "psy": "NODE_ENV=${NODE_ENV:-test} tsx test-app/src/cli/index.ts",
    "uspec": "vitest --config ./spec/unit/vite.config.ts",
    "fspec": "vitest --config ./spec/features/vite.config.ts",
    "build": "echo \"building psychic-spec-helpers...\" && rm -rf dist && tsc -p ./tsconfig.esm.build.json",
    "build:test-app": "rm -rf dist && echo \"building test app to esm...\" && tsc -p ./tsconfig.esm.build.test-app.json",
    "lint": "pnpm eslint --no-warn-ignored \"src/**/*.ts\" \"spec/**/*.ts\" && pnpm prettier . --check",
    "format": "pnpm prettier . --write",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@rvoh/dream": "*",
    "@types/node": "*",
    "@types/supertest": "*",
    "puppeteer": ">=24.15.0",
    "supertest": "*",
    "typescript": "*"
  },
  "devDependencies": {
    "@eslint/js": "=9.0.0",
    "@koa/cors": "^5.0.0",
    "@koa/etag": "^5.0.2",
    "@koa/router": "^15.3.0",
    "@rvoh/dream": "^2.5.7",
    "@rvoh/dream-spec-helpers": "^2.0.0",
    "@rvoh/psychic": "^3.0.5",
    "@types/cookiejar": "^2",
    "@types/node": "^22.5.1",
    "@types/pg": "^8",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "koa-bodyparser": "^4.4.1",
    "koa-conditional-get": "^3.0.0",
    "kysely": "^0.28.14",
    "kysely-codegen": "~0.19.0",
    "luxon-jest-matchers": "^0.1.14",
    "openapi-typescript": "^7.10.1",
    "pg": "^8.13.1",
    "prettier": "^3.5.3",
    "puppeteer": "^24.39.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "cookiejar": "^2.1.4",
    "dotenv": "^17.2.3",
    "pluralize-esm": "^9.0.5"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
